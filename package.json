{
  "name": "aquaguard",
  "version": "1.1.0",
  "description": "AquaGuard 青羽守护 — Blender 自动存档看门狗",
  "main": "src/main/main.js",
  "author": "AquaGuard Studio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis zip --x64",
    "dist:linux": "electron-builder --linux AppImage tar.gz --x64",
    "dist:mac": "electron-builder --mac dmg zip --arm64",
    "dist:all": "electron-builder -mwl"
  },
  "build": {
    "appId": "com.aquaguard.watchdog",
    "productName": "AquaGuard",
    "copyright": "Copyright © 2026 AquaGuard",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/addon",
        "to": "addon"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "AquaGuard_Setup_${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AquaGuard 青羽守护",
      "artifactName": "AquaGuard_Setup_${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "maintainer": "AquaGuard Studio",
      "artifactName": "AquaGuard-${version}-linux-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "identity": null,
      "artifactName": "AquaGuard-${version}-mac-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
